# ---------------------------------------------------------------
# Email (contact form, careers form and CV notifications)
# ---------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=website@vmrcloudsolutions.com
SMTP_PASS=
# "true" for port 465, otherwise leave empty
SMTP_SECURE=
MAIL_FROM="VMR Cloud Website <website@vmrcloudsolutions.com>"

# Where submissions are sent (defaults shown)
CONTACT_TO=rajesh.v@vmrcloudsolutions.com
CAREERS_TO=hr@vmrcloudsolutions.com
# CV uploads; falls back to CAREERS_TO, then hr@
CV_TO=hr@vmrcloudsolutions.com

# Local testing only: print emails to the console instead of sending
# MAIL_TRANSPORT=log

# ---------------------------------------------------------------
# CV storage (Upload Your CV)
# ---------------------------------------------------------------
# Vercel: create a PRIVATE Blob store (Storage > Create > Blob > Private)
# and connect it to the project. Vercel adds this variable automatically.
BLOB_READ_WRITE_TOKEN=

# Self-hosted servers / local development only (ignored on Vercel):
# store CVs on disk, outside the public folder.
# CV_STORAGE=local
# CV_LOCAL_DIR=./.data

# ---------------------------------------------------------------
# Admin panel (/admin)
# ---------------------------------------------------------------
# Neon Postgres: connect it in Vercel (Storage > Create > Neon) and
# Vercel adds DATABASE_URL. Tables are created automatically.
DATABASE_URL=
# Any long secret phrase. Needed once, to create the first Super Admin
# at /admin/setup. Can be removed after that.
ADMIN_SETUP_KEY=

# Local development only: embedded Postgres instead of DATABASE_URL.
# DB_DRIVER=pglite
# PGLITE_DIR=./.data/pglite

# Interview reminders: a daily Vercel Cron (vercel.json, 08:00 IST)
# emails each panel about interviews in the next 24 hours. Set a long
# random value (16+ characters); Vercel sends it with each cron call.
# Without it the reminder route refuses every request.
CRON_SECRET=
# Optional: the address used in links inside reminder emails.
# ADMIN_ORIGIN=https://vmrcloudsolutions.com
